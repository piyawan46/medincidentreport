// @ts-nocheck
function doGet(e) {
  return HtmlService.createTemplateFromFile('index')
    .evaluate()
    .setTitle('Incident-Report');
}


/**
 * รับข้อมูลจากหน้า HTML แล้วบันทึกลง Google Sheets
 */
function submitFormData(data) {
  try {

    var sheet = SpreadsheetApp
      .openById("12RFph8SxsfWAaYGhdHwcrFEnw4Doy13xEVZkgi31bBU")
      .getSheetByName("Sheet1");

    // 🔥 แปลง checkbox 10R (array) → string
    var tenR = Array.isArray(data.tenR) ? data.tenR.join(", ") : "";

    sheet.appendRow([
      new Date(),       // Timestamp (auto)
      data.date || "",  // Date
      data.shift || "",  // Shift
      data.hn || "",    // HN
      tenR,             // 10R
      data.cause || "", // Cause
      data.detail || "",// Detail
      data.severity || "", // Severity
      data.reporter || ""  // Name
    ]);

    return {
      status: 'success',
      message: 'บันทึกข้อมูลสำเร็จ!'
    };

  } catch (error) {
    return {
      status: 'error',
      message: error.toString()
    };
  }
}


/**
 * ใช้ include HTML (ถ้ามีหลายไฟล์)
 */
function include(filename) {
  return HtmlService
    .createHtmlOutputFromFile(filename)
    .getContent();
}
